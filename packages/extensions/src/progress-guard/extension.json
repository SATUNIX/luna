{
  "$schema": "../../../core/schema/extension.schema.json",
  "name": "progress-guard",
  "summary": "Auto-boost against loops: detects repeated actions, A→B→A oscillation, and read-without-progress; prompts self-reflection; auto-nudges when an autonomous-loop is armed (no env var needed); escalates a persistent loop to recovery-orchestrator.",
  "category": "workflow",
  "tier": "T2-T4",
  "layer": 5,
  "entry": "index.ts",
  "hooks": ["session_start", "tool_call", "tool_result", "turn_end"],
  "registers": { "tools": [], "commands": ["reflect", "boost"] },
  "profiles": ["quick", "balanced", "long-horizon", "autonomous", "self-improving", "pentest", "lite"],
  "enabledByDefault": true,
  "platforms": ["windows", "linux", "darwin"],
  "runtime": {
    "nodeBuiltins": ["node:fs", "node:path", "node:crypto"],
    "npm": [],
    "piPeers": [],
    "services": [],
    "models": []
  },
  "profileRequires": ["context-sieve"],
  "pulls": [],
  "env": ["PI_KIT_GUARD_MODE", "PI_KIT_GUARD_REPEAT", "PI_KIT_GUARD_STALL", "PI_KIT_GUARD_OSC", "PI_KIT_GUARD_ESCALATE"],
  "provenance": { "origin": "custom" },
  "homeRepo": null,
  "status": "beta"
}

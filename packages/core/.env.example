# pi-system environment variables
# Copy to ~/.pi/agent/.env and fill in the values you need.
#
# Everything here is optional. An unset variable means the feature falls back to its
# built-in default, and the kit runs with no .env file at all. This file is a checked-in
# template: it must never contain real credentials.

# --- Memory -------------------------------------------------------------------
# Only needed for the memory-mem0 extension (experimental self-improving profile).
# Leave unset and the extension reports "not configured" instead of failing.
# MEM0_API_KEY=
# MEM0_API_URL=
# MEM0_USER_ID=pi-agent

# Backend selector for the memory extensions. Absent = "mcp", which shells out to the
# bundled service (packages/container/mcp-servers/memory-mcp).
# PI_KIT_MEMORY_BACKEND=mcp
# PI_KIT_MEMORY_MCP_COMMAND=node
# PI_KIT_MEMORY_MCP_ARGS=packages/container/mcp-servers/memory-mcp/index.ts

# --- Review and verification --------------------------------------------------
# Model used by dual-review (full profile).
# DUAL_REVIEW_MODEL=
# Model used by the verify-gate reviewer subprocess. Absent = derived from the session model.
# PI_KIT_VERIFY_REVIEW_MODEL=
# Set to 1 to verify after every successful edit instead of at task boundaries.
# PI_KIT_VERIFY_ON_TURN=1
# How long a "verification pending" marker stays valid, in ms (default 1800000 = 30 min).
# PI_KIT_VERIFY_PENDING_TTL_MS=1800000

# --- Subagents ----------------------------------------------------------------
# Extra attempts per subagent spawn after a transient failure (0-5, default 1).
# PI_KIT_SUBAGENT_RETRIES=1
# Backoff between those attempts, in ms (0-60000, default 2000).
# PI_KIT_SUBAGENT_RETRY_BACKOFF_MS=2000
# Non-interactive trust grant for project-local roles (.pi/agents/*.md). Project roles
# normally require interactive operator approval; in a headless run they are refused unless
# the role's exact digest is listed here. Semicolon-separated. Each digest is the sha256 of
# JSON.stringify({ name, systemPrompt, tools, model }) for that role definition.
# PI_KIT_TRUSTED_PROJECT_ROLES=

# --- Governance ---------------------------------------------------------------
# Override the human-console inbox directory. Additive: the default .pi/human-console
# paths stay protected either way.
# PI_KIT_HUMAN_CONSOLE_DIR=
# Policy file and audit log used by the tool firewall.
# PI_KIT_FIREWALL_POLICY=
# PI_KIT_FIREWALL_AUDIT_LOG=

# --- Session helpers ----------------------------------------------------------
# Pin the kit checkout the /profile command drives, instead of discovering it.
# PI_KIT_ROOT=
# Set to 0 to disable the lean-ctx preflight warning.
# PI_KIT_LEAN_CTX=
# Auto-compact threshold in tokens (default 100000, minimum 1000). Takes precedence over
# the value saved by /compact-threshold and locks it for the session.
# PI_KIT_COMPACT_THRESHOLD_TOKENS=

# --- Local model endpoint -----------------------------------------------------
# Base URL of an LM Studio OpenAI-compatible endpoint.
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# --- Install source -----------------------------------------------------------
# Override the git source used by the installer, for private mirrors and forks.
# PI_SYSTEM_GIT_SOURCE=git:github.com/satunix/pi-system

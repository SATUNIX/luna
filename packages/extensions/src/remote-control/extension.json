{
  "$schema": "../../../core/schema/extension.schema.json",
  "name": "remote-control",
  "summary": "/remote: drive pi from the pi remote Android app over the LAN or Tailscale. Links phones with a one-time code plus approval at the terminal, and shares this session with them.",
  "category": "ui",
  "tier": "T1",
  "layer": 6,
  "entry": "index.ts",
  "hooks": [
    "session_start",
    "session_shutdown",
    "session_info_changed",
    "session_compact",
    "agent_start",
    "agent_end",
    "agent_settled",
    "turn_start",
    "turn_end",
    "message_start",
    "message_update",
    "message_end",
    "tool_execution_start",
    "tool_execution_update",
    "tool_execution_end",
    "model_select",
    "thinking_level_select",
    "ui_prompt_start"
  ],
  "registers": { "tools": [], "commands": ["remote"] },
  "profiles": ["balanced", "long-horizon", "autonomous", "self-improving"],
  "enabledByDefault": true,
  "platforms": ["linux", "darwin"],
  "runtime": {
    "nodeBuiltins": ["node:child_process", "node:crypto", "node:fs", "node:net", "node:os", "node:path", "node:url"],
    "npm": [],
    "piPeers": [],
    "services": [],
    "models": []
  },
  "pulls": [],
  "env": [
    "PI_KIT_WEBUI_ROOT",
    "PI_REMOTE_STATE_DIR",
    "PI_REMOTE_BIND",
    "PI_REMOTE_PORT",
    "PI_REMOTE_NAME",
    "PI_REMOTE_ADVERTISE",
    "PI_REMOTE_TOKEN_TTL_MIN",
    "PI_REMOTE_AUTO_ATTACH"
  ],
  "provenance": { "origin": "custom" },
  "homeRepo": null,
  "status": "beta"
}

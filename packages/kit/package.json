{
  "name": "@satunix/pi-kit",
  "version": "0.2.4-beta.5",
  "private": true,
  "description": "Kit resources: skills, prompts, profiles, themes, agent definitions, and workflows.",
  "type": "module",
  "license": "MIT",
  "files": [
    "skills/**",
    "prompts/**",
    "profiles/**",
    "themes/**",
    "agents/**",
    "workflows/**"
  ],
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "skills": [
      "skills/*/SKILL.md"
    ],
    "prompts": [
      "prompts/*.md"
    ],
    "themes": [
      "themes/*.json"
    ]
  }
}

{
  "defaultProvider": "ollama-local",
  "defaultModel": "gemma4:latest",
  "defaultThinkingLevel": "medium",
  "sessionDir": "/srv/data/pi-system/sessions",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 2
  },
  "packages": [
    "/opt/pi-agent/tools/node_modules/pi-mcp-adapter"
  ],
  "extensions": [
    "-builtin:mcp"
  ]
}

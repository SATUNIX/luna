{
  "$schema": "../../../core/schema/extension.schema.json",
  "name": "verify-gate",
  "summary": "General completion verification. /verify and verify_completion run the project check (if any) plus an isolated read-only reviewer that checks the goal, todos, tasks, and requests, and record verdicts. PI_KIT_VERIFY_ON_TURN=1 runs the check after edits.",
  "category": "execution",
  "tier": "T2",
  "layer": 5,
  "entry": "index.ts",
  "hooks": ["session_start", "input", "tool_result", "turn_end"],
  "registers": { "tools": ["verify_completion"], "commands": ["verify"] },
  "profiles": ["balanced", "long-horizon", "autonomous", "self-improving", "pentest", "lite"],
  "enabledByDefault": false,
  "platforms": ["windows", "linux", "darwin"],
  "runtime": {
    "nodeBuiltins": ["node:child_process", "node:fs", "node:os", "node:path", "node:url"],
    "npm": [],
    "piPeers": ["typebox", "@earendil-works/pi-coding-agent"],
    "services": [],
    "models": []
  },
  "pulls": [],
  "env": [
    "PI_KIT_VERIFY_ON_TURN",
    "PI_KIT_VERIFY_CMD",
    "PI_KIT_VERIFY_REVIEW",
    "PI_KIT_VERIFY_REVIEW_MODEL",
    "PI_KIT_VERIFY_REVIEW_TIMEOUT_MS"
  ],
  "provenance": { "origin": "custom" },
  "homeRepo": null,
  "status": "beta"
}

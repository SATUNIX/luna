{
  "name": "@satunix/pi-system",
  "version": "0.2.4-beta.3",
  "description": "Safety-first kit for the pi coding agent: tool firewall, secret guard, checkpoints, verification, memory, orchestration, skills and themes. One package; pick a profile with /profile.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "ai-agent",
    "coding-agent"
  ],
  "license": "MIT",
  "author": "SATUNIX",
  "homepage": "https://github.com/SATUNIX/pi-system#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SATUNIX/pi-system.git"
  },
  "bugs": {
    "url": "https://github.com/SATUNIX/pi-system/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "pi-system": "packages/core/install.mjs"
  },
  "files": [
    "packages/extensions/src/**",
    "!packages/extensions/src/_template/**",
    "packages/extensions/third_party/**",
    "packages/kit/skills/**",
    "packages/kit/prompts/**",
    "packages/kit/profiles/**",
    "packages/kit/themes/**",
    "packages/kit/agents/**",
    "packages/kit/workflows/**",
    "packages/core/install.mjs",
    "packages/core/uninstall.mjs",
    "packages/core/lib/**",
    "packages/core/schema/**",
    "packages/core/policies/**",
    "packages/core/sources.json",
    "packages/core/distribution.json",
    "packages/core/.env.example",
    "packages/web-ui/package.json",
    "packages/web-ui/server/**",
    "packages/web-ui/public/**",
    "CHANGELOG.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "workspaces": [
    "packages/*"
  ],
  "pi": {
    "extensions": [
      "packages/extensions/src/*/index.ts",
      "packages/extensions/third_party/*/index.ts",
      "!packages/extensions/src/_template/index.ts"
    ],
    "skills": [
      "packages/kit/skills/*/SKILL.md"
    ],
    "prompts": [
      "packages/kit/prompts/*.md"
    ],
    "themes": [
      "packages/kit/themes/*.json"
    ]
  },

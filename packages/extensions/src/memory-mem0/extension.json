{
  "$schema": "../../../core/schema/extension.schema.json",
  "name": "memory-mem0",
  "summary": "Mem0-compatible memory tools backed by the kit memory MCP server by default, with legacy mem0 REST support behind PI_KIT_MEMORY_BACKEND=mem0.",
  "category": "memory",
  "tier": "T1-T4",
  "layer": 3,
  "entry": "index.ts",
  "hooks": [],
  "registers": { "tools": ["mem0_add", "mem0_search"], "commands": [] },
  "profiles": ["self-improving"],
  "enabledByDefault": false,
  "platforms": ["windows", "linux", "darwin"],
  "runtime": {
    "nodeBuiltins": ["node:child_process", "node:http", "node:https", "node:path", "node:url", "node:util"],
    "npm": [],
    "piPeers": ["typebox"],
    "services": ["memory-mcp", "optional mem0"],
    "models": []
  },
  "pulls": [],
  "env": ["PI_KIT_MEMORY_BACKEND", "PI_KIT_MEMORY_MCP_COMMAND", "PI_KIT_MEMORY_MCP_ARGS", "MEM0_API_URL", "MEM0_API_KEY", "MEM0_USER_ID"],
  "provenance": { "origin": "custom" },
  "homeRepo": null,
  "status": "experimental"
}

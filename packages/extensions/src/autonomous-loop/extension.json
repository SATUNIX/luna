{
  "$schema": "../../../core/schema/extension.schema.json",
  "name": "autonomous-loop",
  "summary": "Autonomous loop mode. /loop <goal> activates; agent re-queues itself after each turn via pi.sendUserMessage followUp. /loop stop (operator) or the loop_complete tool (model) exits; an aborted or errored turn stops it. Max iterations guarded by PI_KIT_LOOP_MAX (default 20).",
  "category": "workflow",
  "tier": "T3",
  "layer": 4,
  "entry": "index.ts",
  "hooks": ["session_start", "agent_end", "session_shutdown"],
  "registers": { "tools": ["loop_complete"], "commands": ["loop"] },
  "profiles": ["balanced", "long-horizon", "autonomous", "self-improving", "pentest"],
  "enabledByDefault": false,
  "platforms": ["windows", "linux", "darwin"],
  "runtime": {
    "nodeBuiltins": ["node:fs", "node:path"],
    "npm": [],
    "piPeers": ["typebox"],
    "services": [],
    "models": []
  },
  "profileRequires": ["context-sieve"],
  "pulls": [],
  "env": ["PI_KIT_LOOP_MAX"],
  "provenance": { "origin": "custom" },
  "homeRepo": null,
  "status": "beta"
}

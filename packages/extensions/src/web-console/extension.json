{
  "$schema": "../../../core/schema/extension.schema.json",
  "name": "web-console",
  "summary": "/console (and /webui): start, stop and check the bundled Pi Console web UI in packages/web-ui, launched as a detached local server.",
  "category": "ui",
  "tier": "T1",
  "layer": 6,
  "entry": "index.ts",
  "hooks": [],
  "registers": { "tools": [], "commands": ["console", "webui"] },
  "profiles": ["balanced", "long-horizon", "autonomous", "self-improving", "pentest"],
  "enabledByDefault": true,
  "platforms": ["windows", "linux", "darwin"],
  "runtime": {
    "nodeBuiltins": ["node:child_process", "node:crypto", "node:fs", "node:http", "node:os", "node:path", "node:url"],
    "npm": [],
    "piPeers": [],
    "services": [],
    "models": []
  },
  "pulls": [],
  "env": [
    "PI_KIT_NODE",
    "PI_KIT_WEBUI_ROOT",
    "PI_CONSOLE_HOST",
    "PI_CONSOLE_PORT",
    "PI_CONSOLE_TOKEN",
    "PI_CONSOLE_TOKEN_FILE",
    "PI_CONSOLE_AUTH",
    "PI_CONSOLE_ALLOW_REMOTE",
    "PI_CONSOLE_ALLOWED_HOSTS"
  ],
  "provenance": { "origin": "custom" },
  "homeRepo": null,
  "status": "beta"
}
{
  "$schema": "../../../core/schema/extension.schema.json",
  "name": "auto-commit-on-exit",
  "summary": "Opt-in (no profile enables it): commits uncommitted changes when the pi session shuts down, using the last assistant message as the commit message. Never stages the .pi/ directory.",
  "category": "execution",
  "tier": "T0",
  "layer": 1,
  "entry": "index.ts",
  "hooks": ["session_shutdown"],
  "registers": { "tools": [], "commands": [] },
  "profiles": [],
  "enabledByDefault": false,
  "platforms": ["windows", "linux", "darwin"],
  "runtime": {
    "nodeBuiltins": [],
    "npm": [],
    "piPeers": [],
    "services": [],
    "models": []
  },
  "pulls": [],
  "env": [],
  "provenance": { "origin": "vendored" },
  "homeRepo": null,
  "status": "experimental"
}

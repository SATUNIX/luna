{
  "$schema": "../../../core/schema/extension.schema.json",
  "name": "git-checkpoint",
  "summary": "Snapshots the working tree to a shadow ref (refs/luna/checkpoints) when a turn finds it changed, skipping credential files, so /undo and /fork can restore code state; never touches the branch, index or stash.",
  "category": "execution",
  "tier": "T0",
  "layer": 1,
  "entry": "index.ts",
  "hooks": ["session_start", "tool_result", "turn_start", "session_before_fork"],
  "registers": { "tools": [], "commands": ["checkpoints", "undo"] },
  "profiles": ["balanced", "long-horizon", "self-improving", "engagement", "lite"],
  "enabledByDefault": true,
  "platforms": ["windows", "linux", "darwin"],
  "runtime": {
    "nodeBuiltins": ["node:child_process", "node:fs", "node:path"],
    "npm": [],
    "piPeers": [],
    "services": [],
    "models": []
  },
  "pulls": [],
  "env": ["PI_KIT_CHECKPOINT_MAX"],
  "provenance": { "origin": "vendored" },
  "homeRepo": null,
  "status": "stable"
}

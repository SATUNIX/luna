{
  "$comment": "The GitHub repository settings this repository's controls depend on, as the drift check compares them (internal/scripts/github-settings-check.ts, read-only: GET requests through `gh api`). Workflows cannot set these and nothing here changes them: an administrator applies a change in the GitHub settings first, then updates this file in the same reviewed pull request. tests/pin-allowlist-smoke.ts keeps actions.patterns_allowed equal to the third-party actions the workflows use, and tests/workflow-policy-smoke.ts keeps the required checks and environments in step with the workflows.",
  "schemaVersion": 1,
  "repository": "SATUNIX/pi-system",
  "rulesets": [
    {
      "name": "main",
      "target": "branch",
      "enforcement": "active",
      "include": ["~DEFAULT_BRANCH"],
      "bypass_actors": [
        { "actor_type": "RepositoryRole", "actor_id": 5, "bypass_mode": "pull_request" }
      ],
      "rules": {
        "deletion": {},
        "non_fast_forward": {},
        "pull_request": {
          "required_approving_review_count": 1,
          "require_code_owner_review": true,
          "require_last_push_approval": true,
          "dismiss_stale_reviews_on_push": true,
          "required_review_thread_resolution": true
        },
        "required_status_checks": {
          "strict_required_status_checks_policy": true,
          "required_status_checks": [
            { "context": "ci-complete", "integration_id": 15368 },
            { "context": "codeql", "integration_id": 15368 },
            { "context": "semgrep", "integration_id": 15368 },
            { "context": "gitleaks", "integration_id": 15368 },
            { "context": "dependencies", "integration_id": 15368 },
            { "context": "osv-scanner / osv-scan", "integration_id": 15368 },
            { "context": "dependency-review", "integration_id": 15368 },
            { "context": "leak-scan", "integration_id": 15368 },
            { "context": "zizmor", "integration_id": 15368 },
            { "context": "CodeQL", "integration_id": 57789 }
          ]
        },
        "code_scanning": {
          "code_scanning_tools": [
            { "tool": "CodeQL", "security_alerts_threshold": "medium_or_higher", "alerts_threshold": "errors" },
            { "tool": "Semgrep OSS", "security_alerts_threshold": "high_or_higher", "alerts_threshold": "errors" },
            { "tool": "osv-scanner", "security_alerts_threshold": "high_or_higher", "alerts_threshold": "errors" },
            { "tool": "zizmor", "security_alerts_threshold": "high_or_higher", "alerts_threshold": "errors" }
          ]
        }
      }
    },
    {
      "name": "release-tags",
      "target": "tag",
      "enforcement": "active",
      "include": ["refs/tags/v*"],
      "bypass_actors": [
        { "actor_type": "RepositoryRole", "actor_id": 5, "bypass_mode": "always" }
      ],
      "rules": {
        "creation": {},
        "update": {},
        "deletion": {}
      }
    }
  ],
  "actions": {
    "enabled": true,
    "allowed_actions": "selected",
    "sha_pinning_required": true,
    "github_owned_allowed": true,
    "verified_allowed": false,
    "patterns_allowed": [
      "google/osv-scanner-action/.github/workflows/osv-scanner-reusable.yml@b1d267aea5211fa648d9d442fa64b90dbdcbdd36",
      "google/osv-scanner-action/osv-reporter-action@0a65f82af05cd58cf587827b0bb0489548c18346",
      "google/osv-scanner-action/osv-scanner-action@0a65f82af05cd58cf587827b0bb0489548c18346",
      "ossf/scorecard-action@fa7117db83c52d787ae5a89f350999701505d78e",
      "zizmorcore/zizmor-action@53290badfa369cb0bf7ad16342cb62c2fa47ac7b"
    ],
    "indirect": {
      "google/osv-scanner-action/osv-reporter-action@0a65f82af05cd58cf587827b0bb0489548c18346": "called by osv-scanner-reusable.yml@b1d267aea5211fa648d9d442fa64b90dbdcbdd36",
      "google/osv-scanner-action/osv-scanner-action@0a65f82af05cd58cf587827b0bb0489548c18346": "called by osv-scanner-reusable.yml@b1d267aea5211fa648d9d442fa64b90dbdcbdd36"
    }
  },
  "workflow_permissions": {
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false
  },
  "fork_pr_approval_policy": "all_external_contributors",
  "security_and_analysis": {
    "secret_scanning": "enabled",
    "secret_scanning_push_protection": "enabled",
    "secret_scanning_non_provider_patterns": "enabled",
    "secret_scanning_validity_checks": "enabled",
    "dependabot_security_updates": "enabled"
  },
  "vulnerability_alerts": true,
  "environments": {
    "npm": {
      "required_reviewers": ["SATUNIX"],
      "tag_policies": ["v*"]
    }
  }
}

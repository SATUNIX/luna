{
  "$schema": "../../../core/schema/extension.schema.json",
  "name": "caveman",
  "summary": "Compresses the agent's conversational output (to the human and to sub-agents) via a context-sieve contribution. Auto-off for report/doc writing (session-flip). Never compresses file, code, or report content.",
  "category": "workflow",
  "tier": "T1",
  "layer": 3,
  "entry": "index.ts",
  "hooks": ["session_start", "input"],
  "registers": { "tools": [], "commands": ["caveman"] },
  "profiles": ["quick", "balanced", "long-horizon", "autonomous", "self-improving", "pentest", "lite"],
  "enabledByDefault": true,
  "platforms": ["windows", "linux", "darwin"],
  "runtime": {
    "nodeBuiltins": ["node:fs", "node:os", "node:path", "node:crypto"],
    "npm": [],
    "piPeers": [],
    "services": [],
    "models": []
  },
  "profileRequires": ["context-sieve"],
  "pulls": [],
  "env": ["PI_KIT_CAVEMAN_LEVEL", "PI_CODING_AGENT_DIR"],
  "provenance": { "origin": "vendored" },
  "homeRepo": "https://github.com/jonjonrankin/pi-caveman",
  "status": "beta"
}

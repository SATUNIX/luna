{
  "$schema": "../../../core/schema/extension.schema.json",
  "name": "notify",
  "summary": "Sends a native desktop notification when the pi agent finishes a turn and is waiting for input. Supports Windows Terminal, Kitty, and OSC 777 terminals.",
  "category": "ui",
  "tier": "T1",
  "layer": 3,
  "entry": "index.ts",
  "hooks": [
    "agent_start",
    "agent_end"
  ],
  "registers": {
    "tools": [],
    "commands": []
  },
  "profiles": ["balanced", "long-horizon", "self-improving", "engagement", "lite"],
  "enabledByDefault": true,
  "platforms": [
    "windows",
    "linux",
    "darwin"
  ],
  "runtime": {
    "nodeBuiltins": [
      "node:child_process"
    ],
    "npm": [],
    "piPeers": [],
    "services": [],
    "models": []
  },
  "pulls": [],
  "env": [
    "PI_KIT_NOTIFY",
    "PI_KIT_NOTIFY_MIN_SECONDS"
  ],
  "provenance": {
    "origin": "vendored"
  },
  "homeRepo": null,
  "status": "stable"
}

{
  "name": "@satunix/pi-extensions",
  "version": "0.2.4-beta.6",
  "private": true,
  "description": "First-party pi extensions plus vendored third-party extensions with attribution.",
  "type": "module",
  "license": "MIT",
  "files": [
    "src/**/*.ts",
    "src/**/*.md",
    "src/**/*.json",
    "third_party/**/*.ts",
    "third_party/**/*.md",
    "third_party/**/*.json",
    "!src/_template/**"
  ],
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "src/*/index.ts",
      "third_party/*/index.ts",
      "!src/_template/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.1",
    "typebox": "*"
  }
}

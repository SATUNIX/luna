{
  "$schema": "../../../core/schema/extension.schema.json",
  "name": "tool-firewall",
  "summary": "Autonomy gate for every tool call: parses shell commands into their real effects, tiers them (low/medium/high/critical) with session history, auto-allows routine work, judges medium actions in auto mode, learns from operator decisions and denies critical ones.",
  "category": "safety",
  "tier": "T0",
  "layer": 2,
  "entry": "index.ts",
  "hooks": ["tool_call", "session_start", "session_shutdown", "before_agent_start"],
  "registers": { "tools": [], "commands": ["firewall", "firewall:status", "firewall:reload", "auto", "auto-mode", "security"] },
  "profiles": ["quick", "balanced", "long-horizon", "autonomous", "self-improving", "pentest", "lite"],
  "enabledByDefault": true,
  "platforms": ["windows", "linux", "darwin"],
  "runtime": {
    "nodeBuiltins": ["node:crypto", "node:fs", "node:os", "node:path", "node:url"],
    "npm": [],
    "piPeers": [],
    "services": [],
    "models": []
  },
  "pulls": [],
  "env": ["PI_KIT_SECURITY_CONFIG", "PI_KIT_SECURITY_LEVEL", "PI_KIT_AUTO_MODE", "PI_KIT_AUTO_MODE_MODEL", "PI_KIT_AUTO_MODE_STATE_DIR", "PI_KIT_FIREWALL_CONFIG", "PI_KIT_FIREWALL_PROFILE", "PI_KIT_FIREWALL_POLICY", "PI_KIT_FIREWALL_AUDIT_LOG", "PI_KIT_FIREWALL_FEEDBACK", "PI_KIT_FIREWALL_SESSIONS_DIR", "PI_KIT_FIREWALL_JUDGEMENTS", "PI_KIT_FIREWALL_LEARNED_PROFILE", "PI_KIT_FIREWALL_ROOT_SESSION", "PI_KIT_FIREWALL_APPROVALS", "PI_KIT_FIREWALL_PROMPT_TIMEOUT_MS", "PI_KIT_FIREWALL_JUDGE_TIMEOUT_MS", "PI_KIT_HUMAN_CONSOLE_DIR", "PI_KIT_HUMAN_CONSOLE_TIMEOUT_MS", "PI_KIT_WORKFLOW_RUN_ID", "PI_KIT_UNATTENDED", "PI_KIT_UNATTENDED_BOUNDARY", "PI_KIT_UNATTENDED_CONTRACT", "PI_LENS_DISABLE_LSP_INSTALL", "PI_LENS_DISABLE_TOOL_INSTALL"],
  "provenance": { "origin": "custom" },
  "homeRepo": null,
  "status": "beta",
  "childGovernance": true
}

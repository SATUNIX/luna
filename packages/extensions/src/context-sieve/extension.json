{
  "$schema": "../../../core/schema/extension.schema.json",
  "name": "context-sieve",
  "summary": "Single authority for model-visible system-prompt assembly. Collects contributions from other extensions via .pi/ctx-contributions/ files, enforces a token budget, and injects them as system-prompt and hidden-message context; deliberately leaves pi's native compaction summarization untouched.",
  "category": "memory",
  "tier": "T3",
  "layer": 3,
  "entry": "index.ts",
  "hooks": ["session_compact", "session_start", "before_agent_start", "session_before_compact"],
  "registers": { "tools": [], "commands": [] },
  "profiles": ["quick", "balanced", "long-horizon", "autonomous", "self-improving", "pentest", "lite"],
  "enabledByDefault": true,
  "platforms": ["windows", "linux", "darwin"],
  "runtime": {
    "nodeBuiltins": ["node:fs", "node:os", "node:path", "node:crypto"],
    "npm": [],
    "piPeers": [],
    "services": [],
    "models": []
  },
  "pulls": [],
  "env": ["PI_KIT_CTX_BUDGET_TOKENS"],
  "provenance": { "origin": "custom" },
  "homeRepo": null,
  "status": "beta"
}
